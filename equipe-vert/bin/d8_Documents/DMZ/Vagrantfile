Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"

  config.vm.define "DMZ-vert" do |vm|
    vm.vm.hostname = "DMZ-vert"
    vm.vm.network "public_network",
      ip: "192.168.3.194",
      netmask: "255.255.255.192",
      bridge: "enp3s0"

    # script web
    vm.vm.provision "shell", path: "setup_web.sh"

    # script mail
    vm.vm.provision "shell", path: "setup_mail.sh"
    
    # script dns 
    vm.vm.provision "shell", path: "setup_dns.sh"
  end
end
